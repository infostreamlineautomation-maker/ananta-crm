# ==========================================
# Ananta CRM - Backend Environment Config
# ==========================================

# Core Django Security
DJANGO_SECRET_KEY=your-strong-production-secret-key-min-50-chars
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,your-backend-domain.onrender.com

# Database (Supabase PostgreSQL)
# Option 1: Connection String (Recommended for Supabase Session/Transaction Pooler)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Option 2: Separate Parameters (If not using DATABASE_URL)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=db.your-supabase-id.supabase.co
DB_PORT=5432

# CORS & CSRF (Set to your Vercel frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-crm.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://your-crm.vercel.app

# Cross-Domain Cookie Settings (For Vercel <-> Render cross-domain authentication)
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None

# Cloudinary Storage for Assets & Media (Logos, Invoices, Signatures, Images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local File Uploads fallback (if not using Cloudinary)
# MEDIA_ROOT=/path/to/uploads
# MEDIA_URL=/uploads/
