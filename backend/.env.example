# ==========================================
# Ananta CRM - Backend Environment Config
# ==========================================

# Core Django Security
DJANGO_SECRET_KEY=your-strong-production-secret-key-min-50-chars
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=crm.yourdomain.com,localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_NAME=ananta_crm
DB_USER=ananta_user
DB_PASSWORD=YourStrongDatabasePassword123!
DB_HOST=127.0.0.1
DB_PORT=5432

# Or Database URL (e.g. Supabase / Neon / Render)
# DATABASE_URL=postgresql://ananta_user:password@127.0.0.1:5432/ananta_crm

# CORS & CSRF (Set to your CRM production domain)
CORS_ALLOWED_ORIGINS=https://crm.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://crm.yourdomain.com

# Cookie Settings for unified Nginx domain
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=false

# Media & File Uploads (Local VPS storage with subfolders)
MEDIA_URL=/uploads/
MEDIA_ROOT=/var/www/ananta-crm/backend/uploads

# Cloudinary Storage (Optional fallback if using cloud media)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
